FROM node:24-slim AS base
WORKDIR /usr/src/app
RUN npm install --global --ignore-scripts npm@12.1.0

FROM base AS build
COPY package*.json .npmrc ./
RUN --mount=type=cache,target=/root/.npm npm ci --ignore-scripts
COPY tsconfig.json vite.config.ts index.html client-api.json ./
COPY src ./src
COPY zbin ./zbin
COPY scripts ./scripts
COPY resources ./resources
# The self-hosted image uses only the open resources and our own logo.
# Do not COPY the proprietary directory into any stage of this image.
ENV SELF_HOSTED=true
RUN node node_modules/typescript/bin/tsc --noEmit \
    && node node_modules/vite/bin/vite.js build \
    && node --import tsx scripts/buildAssetHashes.ts

FROM base AS dependencies
COPY package*.json .npmrc ./
RUN --mount=type=cache,target=/root/.npm npm ci --omit=dev --ignore-scripts

FROM base AS runtime
RUN apt-get update && apt-get install -y --no-install-recommends nginx supervisor \
    && rm -rf /var/lib/apt/lists/* \
    && rm -f /etc/nginx/sites-enabled/default /etc/nginx/conf.d/default.conf
COPY --from=dependencies /usr/src/app/node_modules ./node_modules
COPY --from=build /usr/src/app/static ./static
COPY package*.json tsconfig.json client-api.json ./
COPY LICENSE LICENSE-ASSETS LICENSING.md ./
COPY src ./src
COPY zbin ./zbin
COPY resources ./resources
RUN rm -rf resources/maps
COPY deploy/render/nginx.conf /etc/nginx/openfront.template
COPY deploy/render/supervisord.conf /etc/supervisor/conf.d/openfront.conf
COPY deploy/render/start.sh generate-nginx-upstream.sh /usr/local/bin/
RUN chmod +x /usr/local/bin/start.sh /usr/local/bin/generate-nginx-upstream.sh
ENV SELF_HOSTED=true GAME_ENV=prod PORT=10000 NUM_WORKERS=1 INSTANCE_LETTER=a LOBBY_COORDINATOR=off
ARG RENDER_GIT_COMMIT=unknown
ENV GIT_COMMIT=$RENDER_GIT_COMMIT
EXPOSE 10000
ENTRYPOINT ["/usr/local/bin/start.sh"]
